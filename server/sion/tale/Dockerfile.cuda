# whisper.cpp med CUDA 12.4 for eldre NVIDIA-kort (GTX 970 = sm_52).
# Det ferdige bildet main-cuda krever CUDA 13, som verken driveren her eller Maxwell-kort støtter.
# Bygg: docker compose ... build sion-tale   (tar ca. 10-20 min første gang)
FROM nvidia/cuda:12.4.1-devel-ubuntu22.04 AS bygg
ARG VERSJON=v1.9.5
ARG ARK=52
RUN apt-get update && apt-get install -y --no-install-recommends git cmake build-essential ca-certificates && rm -rf /var/lib/apt/lists/*
RUN git clone --depth 1 --branch ${VERSJON} https://github.com/ggml-org/whisper.cpp /src
WORKDIR /src
# libcuda (driveren) finnes ikke under bygging; lenk mot CUDA sine stubber, den ekte kommer fra NVIDIA ved kjøring
ENV LIBRARY_PATH=/usr/local/cuda/lib64/stubs
RUN cmake -B build -DGGML_CUDA=1 -DCMAKE_CUDA_ARCHITECTURES=${ARK} -DWHISPER_BUILD_TESTS=OFF -DCMAKE_BUILD_TYPE=Release \
   "-DCMAKE_EXE_LINKER_FLAGS=-Wl,-rpath-link,/usr/local/cuda/lib64/stubs -Wl,--allow-shlib-undefined" \
 && cmake --build build -j 4 --config Release --target whisper-server whisper-cli
RUN mkdir /libs && find build -name '*.so*' -exec cp -a {} /libs/ \;

FROM nvidia/cuda:12.4.1-runtime-ubuntu22.04
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg libgomp1 && rm -rf /var/lib/apt/lists/*
COPY --from=bygg /src/build/bin/ /app/build/bin/
COPY --from=bygg /libs/ /usr/local/lib/
COPY --from=bygg /src/samples/jfk.wav /app/samples/jfk.wav
RUN ldconfig
