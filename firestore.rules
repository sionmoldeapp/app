rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }
    // Medlem: står på medlemslisten (samlingen members), eller er administrator.
    function isMember() {
      return signedIn() && (isAdmin() || exists(/databases/$(database)/documents/members/$(request.auth.token.email)));
    }
    // Gruppeledere: medlemmer med feltet leads på oppføringen sin i members (satt av administrator). De kan opprette, endre og slette
    // nyheter og arrangementer som bare gjelder grupper de leder (groups er ikke tom og ligger innenfor leads, og innholdet er medlemsinnhold).
    function myLeads() {
      return get(/databases/$(database)/documents/members/$(request.auth.token.email)).data.get('leads', []);
    }
    function isLeader() {
      return signedIn() && exists(/databases/$(database)/documents/members/$(request.auth.token.email)) && myLeads().size() > 0;
    }
    function ledGroups(g) {
      return g is list && g.size() > 0 && g.hasOnly(myLeads());
    }
    // Åpent innhold kan alle lese. Innhold merket m == true krever at brukeren er medlem.
    match /{col}/{id} {
      allow read: if col in ['events', 'posts', 'regular'] && (resource.data.m == false || isMember());
      allow write: if col in ['events', 'posts', 'regular'] && isAdmin();
      allow create: if col in ['events', 'posts'] && isLeader() && ledGroups(request.resource.data.get('groups', [])) && request.resource.data.get('m', false) == true;
      allow update: if col in ['events', 'posts'] && isLeader() && ledGroups(resource.data.get('groups', [])) && ledGroups(request.resource.data.get('groups', [])) && request.resource.data.get('m', false) == true;
      allow delete: if col in ['events', 'posts'] && isLeader() && ledGroups(resource.data.get('groups', []));
    }
    // Ansvarsområder: bare medlemmer leser, bare administrator endrer.
    match /roles/{id} {
      allow read: if isMember();
      allow write: if isAdmin();
    }
    // Beskjeder mellom et medlem og de ansvarlige for et område. parts er e-postadressene til deltakerne (avsenderen og personene på området), og bare
    // de kan lese og skrive. Ved opprettelse må alle andre deltakere stå på ansvarsområdet (roles/{roleId}.emails).
    match /threads/{id} {
      allow read: if signedIn() && request.auth.token.email in resource.data.parts;
      allow create: if isMember()
        && request.resource.data.keys().hasOnly(['roleId', 'roleName', 'from', 'fromName', 'parts', 'last', 'lastBy', 'ms', 'unread', 'created'])
        && request.resource.data.from == request.auth.token.email
        && request.resource.data.lastBy == request.auth.token.email
        && request.resource.data.roleId is string && request.resource.data.roleName is string && request.resource.data.roleName.size() <= 60
        && request.resource.data.fromName is string && request.resource.data.fromName.size() <= 60
        && request.resource.data.parts is list && request.resource.data.parts.size() >= 2 && request.resource.data.parts.size() <= 8
        && request.auth.token.email in request.resource.data.parts
        && request.resource.data.parts.toSet().difference(get(/databases/$(database)/documents/roles/$(request.resource.data.roleId)).data.get('emails', []).toSet()).hasOnly([request.auth.token.email])
        && request.resource.data.last is string && request.resource.data.last.size() <= 140
        && request.resource.data.ms is number && request.resource.data.unread is list
        && request.resource.data.created == request.time;
      // Ny melding (last, lastBy, ms, unread) eller markering som lest (bare unread).
      allow update: if signedIn() && request.auth.token.email in resource.data.parts
        && request.resource.data.unread is list && request.resource.data.unread.toSet().difference(resource.data.parts.toSet()).size() == 0
        && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['unread'])
            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['last', 'lastBy', 'ms', 'unread'])
                && request.resource.data.lastBy == request.auth.token.email
                && request.resource.data.last is string && request.resource.data.last.size() <= 140
                && request.resource.data.ms is number));
      allow delete: if isAdmin() || (signedIn() && resource.data.from == request.auth.token.email);
      match /messages/{mid} {
        allow read: if signedIn() && request.auth.token.email in get(/databases/$(database)/documents/threads/$(id)).data.parts;
        allow delete: if signedIn() && (isAdmin() || get(/databases/$(database)/documents/threads/$(id)).data.from == request.auth.token.email);
        allow create: if signedIn() && request.auth.token.email in getAfter(/databases/$(database)/documents/threads/$(id)).data.parts
          && request.resource.data.keys().hasOnly(['by', 'name', 'text', 'created'])
          && request.resource.data.by == request.auth.token.email
          && request.resource.data.name is string && request.resource.data.name.size() <= 60
          && request.resource.data.text is string && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 1000
          && request.resource.data.created == request.time;
      }
    }
    // Bønneemner: alle medlemmer kan sende inn, men bare administratorer og medlemmer i gruppen bonneledere kan lese dem.
    // by bruker uid (ikke e-post). Forfatteren kan slette sitt eget emne, og leserne kan slette alle.
    function prayReader() {
      return isAdmin() || (signedIn() && exists(/databases/$(database)/documents/members/$(request.auth.token.email))
        && 'bonneledere' in get(/databases/$(database)/documents/members/$(request.auth.token.email)).data.get('groups', []));
    }
    match /prayers/{id} {
      allow read: if prayReader() || (signedIn() && resource.data.by == request.auth.uid);   // leserne ser alle, forfatteren ser egne (innsyn og sletting)
      // Innloggede medlemmer sender med navn. Uten innlogging sendes bønneemner anonymt (name tomt og by == 'anonym').
      allow create: if request.resource.data.keys().hasOnly(['t', 'name', 'by', 'ms', 'ber'])
        && request.resource.data.t is string && request.resource.data.t.size() > 0 && request.resource.data.t.size() <= 400
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.ms is number && request.resource.data.ber == []
        && ((isMember() && request.resource.data.name.size() >= 1 && request.resource.data.by == request.auth.uid)
            || (request.resource.data.name == '' && request.resource.data.by == 'anonym'));
      // Lederne markerer emner som bedt for etter bønnemøtet (feltet bedt, tidspunkt).
      allow update: if prayReader() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bedt']) && request.resource.data.bedt is number;
      allow delete: if isMember() && (resource.data.by == request.auth.uid || prayReader());
    }
    // Egne innstillinger (rekkefølgen på kortene under Meg og Hjem): bare eieren leser og skriver sitt eget dokument.
    match /userPrefs/{email} {
      allow read, delete: if signedIn() && request.auth.token.email == email;
      allow create, update: if signedIn() && request.auth.token.email == email && request.resource.data.keys().hasOnly(['meorder', 'homeorder'])
        && (!('meorder' in request.resource.data) || (request.resource.data.meorder is list && request.resource.data.meorder.size() <= 20))
        && (!('homeorder' in request.resource.data) || (request.resource.data.homeorder is list && request.resource.data.homeorder.size() <= 20));
    }
    // Kontaktinfo som vises på Hjem: alle kan lese, bare administrator endrer.
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin() && id == 'contact' && request.resource.data.keys().hasOnly(['address', 'hours', 'phone', 'email']);
    }
    // Sikkerhetspunkter for tilbakerulling (bare administratorer): oversikt i snapshots, innholdet som tekst i snapshotData.
    match /snapshots/{id} { allow read, write: if isAdmin(); }
    match /snapshotData/{id} { allow read, write: if isAdmin(); }
    // «Jeg kommer»-teller per arrangement. Alle kan lese og endre tallet med ett om gangen, bare administratorer kan slette.
    match /rsvpCounts/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == 1;
      allow update: if request.resource.data.keys().hasOnly(['n']) && request.resource.data.n is int && request.resource.data.n >= 0
        && (request.resource.data.n - resource.data.n == 1 || resource.data.n - request.resource.data.n == 1);
      allow delete: if isAdmin();
    }
    // Påmeldinger med navn («Jeg kommer»): alle kan melde seg på (og trekke seg), bare administratorer og gruppeledere leser listen.
    match /rsvps/{id} {
      allow create, update: if request.resource.data.keys().hasOnly(['eventId', 'title', 'start', 'name', 'contact', 'groups', 'created'])
        && request.resource.data.eventId is string && request.resource.data.eventId.size() <= 80
        && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 80
        && request.resource.data.contact is string && request.resource.data.contact.size() <= 120
        && request.resource.data.title is string && request.resource.data.title.size() <= 200
        && request.resource.data.start is string && request.resource.data.start.size() <= 20
        && request.resource.data.groups is list && request.resource.data.groups.size() <= 20
        && request.resource.data.created == request.time;
      allow delete: if true;
      allow read: if isAdmin() || isLeader();
    }

    // Antall som har sett en nyhet: alle kan telle opp med ett, bare administratorer og gruppeledere leser.
    match /postViews/{id} {
      allow read: if isAdmin() || isLeader();
      allow create: if request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == 1;
      allow update: if request.resource.data.keys().hasOnly(['n']) && request.resource.data.n is int && request.resource.data.n - resource.data.n == 1;
    }

    // Planlagte varsler: administratorer kan planlegge til alle, gruppeledere bare til egne grupper. Bare administratorer/scriptet leser og sletter.
    match /scheduled/{id} {
      allow create: if request.resource.data.keys().hasOnly(['title', 'body', 'tab', 'malType', 'groups', 'ltypes', 'kopi', 'fireAt', 'by', 'created'])
        && request.resource.data.title is string && request.resource.data.title.size() <= 100
        && request.resource.data.fireAt is int
        && (isAdmin() || (isLeader() && request.resource.data.malType == 'grupper'
             && request.resource.data.groups is list && request.resource.data.groups.size() > 0 && request.resource.data.groups.hasOnly(myLeads())));
      allow read, update, delete: if isAdmin();
    }

    // Lederkategorier (Hovedledere, Ungdomsledere, Forkynnere ...): bare administratorer.
    match /leaderTypes/{id} {
      allow read, write: if isAdmin();
    }

    // Kategorier for arrangementer og faste samlinger: alle kan lese, bare administratorer endrer.
    match /categories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Grupper (navn og beskrivelse): alle kan lese, bare administratorer endrer.
    match /groups/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Påminnelser før samlinger. Alle kan opprette og slette (id-en inneholder en del av varselkoden); bare administratorer/scriptet leser.
    match /reminders/{id} {
      allow create: if request.resource.data.keys().hasOnly(['token', 'title', 'fireAt', 'created'])
        && request.resource.data.token is string && request.resource.data.token.size() >= 100 && request.resource.data.token.size() <= 500
        && request.resource.data.title is string && request.resource.data.title.size() <= 200
        && request.resource.data.fireAt is int
        && request.resource.data.created == request.time;
      allow delete: if true;
      allow read, update: if isAdmin();
    }

    // Varselkoder for push. Besøkende kan registrere en enhet, men aldri tildele seg grupper (groups må være tom). En innlogget bruker
    // kan koble koden til sin egen e-post (email), og bare sin egen. Gruppene hentes fra brukerens oppføring i members/admins, aldri herfra. Koden er
    // dokument-ID og må ha lengde som en ekte FCM-kode. Å slette krever at man kjenner koden (den er hemmelig for enheten).
    // Bare administratorer kan lese listen eller sette grupper. Dette hindrer ikke at fremmede legger inn søppelkoder.
    match /pushTokens/{token} {
      allow create, update: if request.resource.data.keys().hasOnly(['token', 'groups', 'created', 'email'])
        && request.resource.data.token == token
        && token.size() >= 100 && token.size() <= 500
        && request.resource.data.groups is list && request.resource.data.groups.size() == 0
        && request.resource.data.created == request.time
        && (!('email' in request.resource.data) || (signedIn() && request.resource.data.email == request.auth.token.email));
      allow delete: if true;
      allow read, write: if isAdmin();
    }
    // Medlemslisten: e-postadressen er dokument-ID. Brukeren kan sjekke sin egen adresse, administratorer styrer listen.
    // Gruppeledere kan se medlemslisten (for å styre sine grupper), legge nye medlemmer inn i egne grupper, og bare endre feltet groups
    // på eksisterende medlemmer: de kan bare legge til eller fjerne grupper de selv leder.
    match /members/{email} {
      allow get: if signedIn() && request.auth.token.email == email || isAdmin() || isLeader();
      allow list: if isAdmin() || isLeader();
      allow write: if isAdmin();
      // Hver bruker kan endre eget navn og hvilke gruppevarsler hen vil ha (name, muted), og slette seg selv (ikke administratorer).
      allow update: if signedIn() && request.auth.token.email == email
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'muted'])
        && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 60))
        && (!('muted' in request.resource.data) || (request.resource.data.muted is list && request.resource.data.muted.size() <= 30));
      allow delete: if signedIn() && request.auth.token.email == email && !isAdmin();
      allow create: if isLeader()
        && request.resource.data.keys().hasOnly(['email', 'rolle', 'created', 'by', 'groups'])
        && request.resource.data.email == email
        && request.resource.data.groups is list && request.resource.data.groups.size() > 0
        && request.resource.data.groups.hasOnly(myLeads());
      allow update: if isLeader()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['groups'])
        && request.resource.data.groups is list
        && request.resource.data.groups.toSet().difference(resource.data.get('groups', []).toSet()).hasOnly(myLeads())
        && resource.data.get('groups', []).toSet().difference(request.resource.data.groups.toSet()).hasOnly(myLeads());
    }
    // Vakter per gruppe: bare gruppens medlemmer (og administratorer) leser. Leder av gruppen (eller administrator) endrer vaktene.
    // Medlemmer i gruppen kan sende en byttebeskjed (requests) som bare avsenderen, gruppens leder og administratorer ser.
    function inGroup(g) {
      return signedIn() && (isAdmin() || (exists(/databases/$(database)/documents/members/$(request.auth.token.email))
        && g in get(/databases/$(database)/documents/members/$(request.auth.token.email)).data.get('groups', [])));
    }
    function leadsGroup(g) {
      return isLeader() && g in myLeads();
    }
    match /shifts/{group}/items/{id} {
      allow read: if inGroup(group) || leadsGroup(group);
      allow write: if isAdmin() || leadsGroup(group);
    }
    match /shifts/{group}/requests/{id} {
      allow create: if (inGroup(group) || leadsGroup(group))
        && request.resource.data.keys().hasOnly(['shiftId', 'date', 'role', 'from', 'fromName', 'text', 'created'])
        && request.resource.data.from == request.auth.token.email
        && request.resource.data.text is string && request.resource.data.text.size() <= 300
        && request.resource.data.created == request.time;
      allow read, delete: if isAdmin() || leadsGroup(group) || (signedIn() && resource.data.from == request.auth.token.email);
    }

    // Private møtenotater: bare eieren (ikke engang administratorer). Maks 100 notater (plassene n1 til n100), hvert opptil 20 000 tegn.
    match /members/{email}/notes/{noteId} {
      allow read, delete: if signedIn() && request.auth.token.email == email && isMember();
      allow create, update: if signedIn() && request.auth.token.email == email && isMember()
        && noteId.matches('n([1-9]|[1-9][0-9]|100)')
        && request.resource.data.keys().hasOnly(['title', 'date', 'speaker', 'html', 'updated'])
        && request.resource.data.title is string && request.resource.data.title.size() <= 120
        && request.resource.data.speaker is string && request.resource.data.speaker.size() <= 80
        && request.resource.data.date is string && request.resource.data.date.size() <= 10
        && request.resource.data.html is string && request.resource.data.html.size() <= 20000
        && request.resource.data.updated == request.time;
    }
    // Administratorer er dokumenter i admins, med e-postadressen som dokument-ID. Bare administratorer kan endre listen.
    match /admins/{email} {
      allow get: if signedIn() && request.auth.token.email == email || isAdmin();
      allow list, write: if isAdmin();
    }
  }
}
