rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }
    // Medlem: står på medlemslisten (samlingen members), eller er administrator.
    function isMember() {
      return signedIn() && (isAdmin() || exists(/databases/$(database)/documents/members/$(request.auth.token.email)));
    }
    // Gruppeledere: medlemmer med feltet leads på oppføringen sin i members (satt av administrator). De kan opprette, endre og slette
    // nyheter og arrangementer som bare gjelder grupper de leder (groups er ikke tom og ligger innenfor leads, og innholdet er medlemsinnhold).
    function myLeads() {
      return get(/databases/$(database)/documents/members/$(request.auth.token.email)).data.get('leads', []);
    }
    function isLeader() {
      return signedIn() && exists(/databases/$(database)/documents/members/$(request.auth.token.email)) && myLeads().size() > 0;
    }
    function ledGroups(g) {
      return g is list && g.size() > 0 && g.hasOnly(myLeads());
    }
    // Åpent innhold kan alle lese. Innhold merket m == true krever at brukeren er medlem.
    match /{col}/{id} {
      allow read: if col in ['events', 'posts', 'regular'] && (resource.data.m == false || isMember());
      allow write: if col in ['events', 'posts', 'regular'] && isAdmin();
      allow create: if col in ['events', 'posts'] && isLeader() && ledGroups(request.resource.data.get('groups', [])) && request.resource.data.get('m', false) == true;
      allow update: if col in ['events', 'posts'] && isLeader() && ledGroups(resource.data.get('groups', [])) && ledGroups(request.resource.data.get('groups', [])) && request.resource.data.get('m', false) == true;
      allow delete: if col in ['events', 'posts'] && isLeader() && ledGroups(resource.data.get('groups', []));
    }
    // Raske svar på gruppebeskjeder (posts/{id}/svar/{e-post}). Et medlem i en av gruppene beskjeden gjelder kan svare (Ok, Kommer, Kommer ikke og/eller en kort tekst, maks 140 tegn).
    // Svaret kan leses av avsenderen selv, administratorer og lederne for gruppene beskjeden gjelder. Andre medlemmer ser det ikke.
    match /posts/{pid}/svar/{uid} {
      allow read: if signedIn() && (uid == request.auth.token.email || isAdmin()
        || (isLeader() && myLeads().toSet().intersection(get(/databases/$(database)/documents/posts/$(pid)).data.get('groups', []).toSet()).size() > 0));
      allow create, update: if isMember() && uid == request.auth.token.email
        && request.resource.data.keys().hasOnly(['by', 'name', 'k', 't', 'ms'])
        && request.resource.data.by == request.auth.token.email
        && request.resource.data.k in ['ok', 'kommer', 'ikke', 'tekst']
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.t is string && request.resource.data.t.size() <= 140
        && request.resource.data.ms is number
        && get(/databases/$(database)/documents/posts/$(pid)).data.get('svar', false) == true
        && (isAdmin() || get(/databases/$(database)/documents/members/$(request.auth.token.email)).data.get('groups', []).toSet().intersection(get(/databases/$(database)/documents/posts/$(pid)).data.get('groups', []).toSet()).size() > 0);
      allow delete: if signedIn() && (uid == request.auth.token.email || isAdmin());
    }
    // Ringing i Sionchat (kun ringelyd, ikke samtale). Dokument-ID er samtalens id. Den som ringer oppretter/fornyer og avbryter;
    // mottakerne kan bare sette status til svart. Bare deltakere i samtalen kan ringe.
    match /ringer/{tid} {
      allow read: if signedIn() && (request.auth.token.email in resource.data.til || request.auth.token.email == resource.data.fra);
      allow create, update: if isMember() && request.resource.data.fra == request.auth.token.email
        && request.resource.data.keys().hasOnly(['fra', 'fraNavn', 'til', 'status', 'ms', 'svarNavn'])
        && request.resource.data.til is list && request.resource.data.til.size() >= 1 && request.resource.data.til.size() <= 8
        && request.resource.data.fraNavn is string && request.resource.data.fraNavn.size() <= 60
        && request.resource.data.status in ['ring', 'avbrutt'] && request.resource.data.ms is number
        && request.auth.token.email in get(/databases/$(database)/documents/threads/$(tid)).data.parts;
      allow update: if signedIn() && request.auth.token.email in resource.data.til
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'svarNavn'])
        && request.resource.data.status == 'svart'
        && (!('svarNavn' in request.resource.data) || request.resource.data.svarNavn.size() <= 60);
      allow delete: if signedIn() && request.auth.token.email == resource.data.fra;
    }
    // Ansvarsområder: bare medlemmer leser, bare administrator endrer.
    match /roles/{id} {
      allow read: if isMember();
      allow write: if isAdmin();
    }
    // Beskjeder mellom et medlem og de ansvarlige for et område. parts er e-postadressene til deltakerne (avsenderen og personene på området), og bare
    // de kan lese og skrive. Ved opprettelse må alle andre deltakere stå på ansvarsområdet (roles/{roleId}.emails).
    // Reaksjonsfelt på en melding: en deltaker kan bare legge til eller fjerne sin egen e-post i listen f.
    function lykOK(f) {
      return !(f in request.resource.data.diff(resource.data).affectedKeys())
        || (request.resource.data[f] is list && request.resource.data[f].size() <= 8
            && request.resource.data[f].toSet().difference(resource.data.get(f, []).toSet()).hasOnly([request.auth.token.email])
            && resource.data.get(f, []).toSet().difference(request.resource.data[f].toSet()).hasOnly([request.auth.token.email]));
    }
    match /threads/{id} {
      allow read: if signedIn() && request.auth.token.email in resource.data.parts;
      allow create: if isMember()
        && request.resource.data.keys().hasOnly(['roleId', 'roleName', 'from', 'fromName', 'parts', 'last', 'lastBy', 'ms', 'unread', 'created'])
        && request.resource.data.from == request.auth.token.email
        && request.resource.data.lastBy == request.auth.token.email
        && request.resource.data.roleId is string && request.resource.data.roleName is string && request.resource.data.roleName.size() <= 60
        && request.resource.data.fromName is string && request.resource.data.fromName.size() <= 60
        && request.resource.data.parts is list && request.resource.data.parts.size() >= 2 && request.resource.data.parts.size() <= 8
        && request.auth.token.email in request.resource.data.parts
        && request.resource.data.parts.toSet().difference(get(/databases/$(database)/documents/roles/$(request.resource.data.roleId)).data.get('emails', []).toSet()).hasOnly([request.auth.token.email])
        && request.resource.data.last is string && request.resource.data.last.size() <= 140
        && request.resource.data.ms is number && request.resource.data.unread is list
        && request.resource.data.created == request.time;
      // Privat beskjed fra en gruppeleder til ett medlem i en av gruppene vedkommende har ansvar for (administrator kan skrive til alle medlemmer).
      // parts er alltid [avsender, mottaker]. Mottakeren svarer i samme samtale (se update under).
      allow create: if isMember()
        && request.resource.data.keys().hasOnly(['roleId', 'roleName', 'kind', 'toName', 'from', 'fromName', 'parts', 'last', 'lastBy', 'ms', 'unread', 'created'])
        && request.resource.data.kind == 'dm' && request.resource.data.roleId == 'dm'
        && request.resource.data.from == request.auth.token.email && request.resource.data.lastBy == request.auth.token.email
        && request.resource.data.roleName is string && request.resource.data.roleName.size() <= 60
        && request.resource.data.toName is string && request.resource.data.toName.size() <= 60
        && request.resource.data.fromName is string && request.resource.data.fromName.size() <= 60
        && request.resource.data.parts is list && request.resource.data.parts.size() == 2
        && request.resource.data.parts[0] == request.auth.token.email && request.resource.data.parts[1] != request.auth.token.email
        && exists(/databases/$(database)/documents/members/$(request.resource.data.parts[1]))
        && (isAdmin() || (isLeader() && get(/databases/$(database)/documents/members/$(request.resource.data.parts[1])).data.get('groups', []).toSet().hasAny(myLeads().toSet()))
            // Beskjed om en booking: medlemmer i gruppen utleie kan skrive til ledere for gruppen vertskap.
            || (utleieTilgang() && 'vertskap' in get(/databases/$(database)/documents/members/$(request.resource.data.parts[1])).data.get('leads', [])))
        && request.resource.data.last is string && request.resource.data.last.size() <= 140
        && request.resource.data.ms is number && request.resource.data.unread is list
        && request.resource.data.created == request.time;
      // Gruppesamtale: administrator eller gruppeleder for gruppen (gid) oppretter en felles samtale med opptil 40 deltakere. Alle deltakerne kan skrive.
      allow create: if isMember()
        && request.resource.data.keys().hasOnly(['roleId', 'roleName', 'kind', 'gid', 'from', 'fromName', 'parts', 'last', 'lastBy', 'ms', 'unread', 'created'])
        && request.resource.data.kind == 'gruppe' && request.resource.data.roleId == 'gruppe'
        && request.resource.data.from == request.auth.token.email && request.resource.data.lastBy == request.auth.token.email
        && request.resource.data.roleName is string && request.resource.data.roleName.size() >= 1 && request.resource.data.roleName.size() <= 60
        && request.resource.data.fromName is string && request.resource.data.fromName.size() <= 60
        && request.resource.data.gid is string
        && request.resource.data.parts is list && request.resource.data.parts.size() >= 3 && request.resource.data.parts.size() <= 40
        && request.resource.data.parts[0] == request.auth.token.email
        && (isAdmin() || (isLeader() && request.resource.data.gid in myLeads()))
        && request.resource.data.last is string && request.resource.data.last.size() <= 140
        && request.resource.data.ms is number && request.resource.data.unread is list
        && request.resource.data.created == request.time;
      // Ny melding (last, lastBy, ms, unread) eller markering som lest (bare unread).
      allow update: if signedIn() && request.auth.token.email in resource.data.parts
        && request.resource.data.unread is list && request.resource.data.unread.toSet().difference(resource.data.parts.toSet()).size() == 0
        && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['unread'])
            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['last', 'lastBy', 'ms', 'unread', 'gone'])
                && (!('gone' in request.resource.data) || request.resource.data.gone == [])
                && request.resource.data.lastBy == request.auth.token.email
                && request.resource.data.last is string && request.resource.data.last.size() <= 140
                && request.resource.data.ms is number));
      // Skjule en samtale for seg selv: deltakeren kan bare legge til eller fjerne sin egen e-post i feltet gone.
      allow update: if signedIn() && request.auth.token.email in resource.data.parts
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['gone'])
        && request.resource.data.gone is list && request.resource.data.gone.size() <= 8
        && request.resource.data.gone.toSet().difference(resource.data.get('gone', []).toSet()).hasOnly([request.auth.token.email])
        && resource.data.get('gone', []).toSet().difference(request.resource.data.gone.toSet()).hasOnly([request.auth.token.email]);
      // Farge på samtalen: begge deltakerne kan velge en av de faste fargene.
      allow update: if signedIn() && request.auth.token.email in resource.data.parts
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['farge', 'bakgrunn'])
        && request.resource.data.get('farge', 'blaa') in ['blaa', 'rosa', 'gronn', 'lilla', 'oransje', 'rod', 'turkis', 'gull']
        && request.resource.data.get('bakgrunn', 'ingen') in ['ingen', 'himmel', 'solnedgang', 'skog', 'natt', 'rosa', 'sion'];
      // Samtalebilde: et lite bilde (data-URL) som begge deltakerne kan bytte.
      allow update: if signedIn() && request.auth.token.email in resource.data.parts
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bilde'])
        && (!('bilde' in request.resource.data) || (request.resource.data.bilde is string && request.resource.data.bilde.size() <= 30000 && request.resource.data.bilde.matches('^data:image/jpeg;base64,.*')));
      // Dempe en samtale for seg selv: bare egen e-post i feltet dempet.
      allow update: if signedIn() && request.auth.token.email in resource.data.parts
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['dempet'])
        && lykOK('dempet');
      allow delete: if isAdmin() || (signedIn() && resource.data.from == request.auth.token.email);
      // Bønneliste i samtalen: begge deltakerne legger til emner, ber (egen e-post i bedt) og merker som besvart.
      match /bonner/{bid} {
        allow read: if signedIn() && request.auth.token.email in get(/databases/$(database)/documents/threads/$(id)).data.parts;
        allow create: if signedIn() && request.auth.token.email in get(/databases/$(database)/documents/threads/$(id)).data.parts
          && request.resource.data.keys().hasOnly(['t', 'by', 'navn', 'ms', 'bedt', 'besvart'])
          && request.resource.data.by == request.auth.token.email
          && request.resource.data.t is string && request.resource.data.t.size() >= 1 && request.resource.data.t.size() <= 200
          && request.resource.data.navn is string && request.resource.data.navn.size() <= 60
          && request.resource.data.ms is number && request.resource.data.bedt == [] && request.resource.data.besvart == false;
        allow update: if signedIn() && request.auth.token.email in get(/databases/$(database)/documents/threads/$(id)).data.parts
          && ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bedt']) && lykOK('bedt'))
              || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['besvart']) && request.resource.data.besvart is bool));
        allow delete: if signedIn() && (resource.data.by == request.auth.token.email || isAdmin());
      }
      match /messages/{mid} {
        allow read: if signedIn() && request.auth.token.email in get(/databases/$(database)/documents/threads/$(id)).data.parts;
        allow delete: if signedIn() && (isAdmin() || get(/databases/$(database)/documents/threads/$(id)).data.from == request.auth.token.email);
        // Angre en melding du selv har sendt: teksten tømmes og slettet settes.
        allow update: if signedIn() && resource.data.by == request.auth.token.email
          && request.auth.token.email in get(/databases/$(database)/documents/threads/$(id)).data.parts
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'slettet', 'img', 'svar', 'lyd', 'lsek', 'avst'])
          && request.resource.data.slettet == true && request.resource.data.text == ''
          && !('img' in request.resource.data) && !('svar' in request.resource.data)
          && !('lyd' in request.resource.data) && !('lsek' in request.resource.data) && !('avst' in request.resource.data);
        // Rediger en melding du selv har sendt (bare tekstmeldinger).
        allow update: if signedIn() && resource.data.by == request.auth.token.email
          && request.auth.token.email in get(/databases/$(database)/documents/threads/$(id)).data.parts
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'redigert'])
          && request.resource.data.redigert == true
          && request.resource.data.text is string && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 1000
          && !('slettet' in resource.data) && !('img' in resource.data);
        // 👍 på en melding: deltakerne kan bare legge til eller fjerne sin egen e-post i feltet likes.
        allow update: if signedIn() && request.auth.token.email in get(/databases/$(database)/documents/threads/$(id)).data.parts
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'r_hjerte', 'r_ler', 'r_wow', 'r_trist', 'r_be', 'r_ild', 'r_hender', 'r_sion', 'r_amen'])
          && lykOK('likes') && lykOK('r_hjerte') && lykOK('r_ler') && lykOK('r_wow') && lykOK('r_trist') && lykOK('r_be')
          && lykOK('r_ild') && lykOK('r_hender') && lykOK('r_sion') && lykOK('r_amen');
        // Stjernemerke: bare egen e-post i feltet stjerne.
        allow update: if signedIn() && request.auth.token.email in get(/databases/$(database)/documents/threads/$(id)).data.parts
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stjerne'])
          && lykOK('stjerne');
        allow create: if signedIn() && request.auth.token.email in getAfter(/databases/$(database)/documents/threads/$(id)).data.parts
          && request.resource.data.keys().hasOnly(['by', 'name', 'text', 'created', 'svar', 'img', 'lyd', 'lsek', 'avst'])
          && request.resource.data.by == request.auth.token.email
          && request.resource.data.name is string && request.resource.data.name.size() <= 60
          && request.resource.data.text is string && request.resource.data.text.size() <= 1000
          && (request.resource.data.text.size() >= 1 || ('img' in request.resource.data) || ('lyd' in request.resource.data) || ('avst' in request.resource.data))
          && (!('lyd' in request.resource.data) || (request.resource.data.lyd is string && request.resource.data.lyd.size() <= 200000 && request.resource.data.lsek is number && request.resource.data.lsek <= 120))
          && (!('avst' in request.resource.data) || (request.resource.data.avst is map && request.resource.data.avst.keys().hasOnly(['id'])))
          && (!('img' in request.resource.data) || (request.resource.data.img is string && request.resource.data.img.size() <= 200000))
          && (!('svar' in request.resource.data) || (request.resource.data.svar is map && request.resource.data.svar.keys().hasOnly(['id', 'navn', 'tekst'])
              && request.resource.data.svar.navn is string && request.resource.data.svar.navn.size() <= 60
              && request.resource.data.svar.tekst is string && request.resource.data.svar.tekst.size() <= 120))
          && request.resource.data.created == request.time;
      }
    }
    // Avstemninger i chatten: opprettes av administrator eller gruppeleder for egne grupper. Medlemmer i gruppene kan lese og stemme (egen e-post i v0 … v4).
    function avstTilgang() {
      return isMember() && (isAdmin() || resource.data.by == request.auth.token.email
        || get(/databases/$(database)/documents/members/$(request.auth.token.email)).data.get('groups', []).toSet().hasAny(resource.data.grupper.toSet()));
    }
    match /avst/{aid} {
      allow get: if avstTilgang();
      allow create: if isMember() && request.resource.data.by == request.auth.token.email
        && request.resource.data.keys().hasOnly(['sp', 'val', 'by', 'byNavn', 'grupper', 'ms'])
        && request.resource.data.sp is string && request.resource.data.sp.size() >= 1 && request.resource.data.sp.size() <= 120
        && request.resource.data.val is list && request.resource.data.val.size() >= 2 && request.resource.data.val.size() <= 5
        && request.resource.data.byNavn is string && request.resource.data.byNavn.size() <= 60
        && request.resource.data.grupper is list && request.resource.data.ms is number
        && (isAdmin() || (isLeader() && request.resource.data.grupper.size() > 0 && request.resource.data.grupper.hasOnly(myLeads())));
      allow update: if avstTilgang()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['v0', 'v1', 'v2', 'v3', 'v4'])
        && lykOK('v0') && lykOK('v1') && lykOK('v2') && lykOK('v3') && lykOK('v4');
      allow delete: if signedIn() && (resource.data.by == request.auth.token.email || isAdmin());
    }
    // Bønneemner: alle medlemmer kan sende inn, men bare administratorer og medlemmer i gruppen bonneledere kan lese dem.
    // by bruker uid (ikke e-post). Forfatteren kan slette sitt eget emne, og leserne kan slette alle.
    function prayReader() {
      return isAdmin() || (signedIn() && exists(/databases/$(database)/documents/members/$(request.auth.token.email))
        && 'bonneledere' in get(/databases/$(database)/documents/members/$(request.auth.token.email)).data.get('groups', []));
    }
    // Saker til lederrådet: administratorer og medlemmer i gruppen lederradet leser og legger til. Alle disse kan merke en sak som behandlet
    // (bare done og doneMs kan endres). Forfatteren og administratorer sletter.
    match /lrsaker/{id} {
      allow read: if inGroup('lederradet');
      allow create: if inGroup('lederradet') && request.resource.data.keys().hasOnly(['t', 'tittel', 'bh', 'name', 'by', 'ms', 'done'])
        && request.resource.data.t is string && request.resource.data.t.size() > 0 && request.resource.data.t.size() <= 2000
        && (!('tittel' in request.resource.data) || (request.resource.data.tittel is string && request.resource.data.tittel.size() <= 100))
        && (!('bh' in request.resource.data) || (request.resource.data.bh is string && request.resource.data.bh.size() <= 8000))
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.by == request.auth.token.email && request.resource.data.ms is number && request.resource.data.done == false;
      allow update: if inGroup('lederradet') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['done', 'doneMs'])
        && request.resource.data.done is bool;
      allow delete: if isAdmin() || (signedIn() && resource.data.by == request.auth.token.email);
    }
    match /prayers/{id} {
      allow read: if prayReader() || (signedIn() && resource.data.by == request.auth.uid);   // leserne ser alle, forfatteren ser egne (innsyn og sletting)
      // Bare innloggede medlemmer skriver direkte (med navn). Anonyme bønneemner uten innlogging går via Apps Script, som skriver med egen tilgang.
      allow create: if request.resource.data.keys().hasOnly(['t', 'name', 'by', 'ms', 'ber'])
        && request.resource.data.t is string && request.resource.data.t.size() > 0 && request.resource.data.t.size() <= 400
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.ms is number && request.resource.data.ber == []
        && isMember() && request.resource.data.name.size() >= 1 && request.resource.data.by == request.auth.uid;
      // Lederne markerer emner som bedt for etter bønnemøtet (feltet bedt, tidspunkt).
      allow update: if prayReader() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bedt']) && request.resource.data.bedt is number;
      allow delete: if isMember() && (resource.data.by == request.auth.uid || prayReader());
    }
    // Egne innstillinger (rekkefølgen på kortene under Meg og Hjem): bare eieren leser og skriver sitt eget dokument.
    match /userPrefs/{email} {
      allow read, delete: if signedIn() && request.auth.token.email == email;
      allow create, update: if signedIn() && request.auth.token.email == email && request.resource.data.keys().hasOnly(['meorder', 'homeorder', 'suborder'])
        && (!('meorder' in request.resource.data) || (request.resource.data.meorder is list && request.resource.data.meorder.size() <= 20))
        && (!('homeorder' in request.resource.data) || (request.resource.data.homeorder is list && request.resource.data.homeorder.size() <= 20))
        && (!('suborder' in request.resource.data) || (request.resource.data.suborder is string && request.resource.data.suborder.size() <= 1500));
    }
    // Politiattest: godkjent dato (attester) og dokumentet (attestfil). Alle endringer går via et forslag (attestforslag) som må bekreftes av BÅDE medlemmet
    // og en gruppeleder for medlemmets grupper (eller en administrator; en leder kan ikke bekrefte sin egen). Foreslått dokument ligger i attestfilny til forslaget er fullført.
    // Når et medlem sletter seg selv (medlemsoppføringen er borte), kan eieren fjerne restene uten bekreftelse. Lister kan bare administratorer hente.
    function attestLeder(email) {
      return isLeader() && exists(/databases/$(database)/documents/members/$(email))
        && get(/databases/$(database)/documents/members/$(email)).data.get('groups', []).hasAny(myLeads());
    }
    function attSelf(email) { return signedIn() && request.auth.token.email == email && isMember(); }
    function attLed(email) { return signedIn() && (isAdmin() || (attestLeder(email) && request.auth.token.email != email)); }
    function attParter(email) { return attSelf(email) || attLed(email); }
    function attFors(email) { return get(/databases/$(database)/documents/attestforslag/$(email)).data; }
    function attFerdig(email, k) {
      return exists(/databases/$(database)/documents/attestforslag/$(email))
        && attFors(email).okM == true && attFors(email).okL == true && attFors(email).k == k;
    }
    function attRydd(email) {
      return signedIn() && !exists(/databases/$(database)/documents/members/$(email))
        && (request.auth.token.email == email || isAdmin());
    }
    match /attester/{email} {
      allow get: if attParter(email);
      allow list: if isAdmin();
      allow create: if attParter(email) && attFerdig(email, 'sett')
        && request.resource.data.keys().hasOnly(['dato', 'by', 'updated', 'godkjent', 'fil'])
        && request.resource.data.dato == attFors(email).dato && request.resource.data.godkjent == true
        && request.resource.data.fil == attFors(email).fil
        && request.resource.data.by == request.auth.token.email && request.resource.data.updated == request.time;
      allow update: if (attParter(email) && attFerdig(email, 'sett')
          && request.resource.data.keys().hasOnly(['dato', 'by', 'updated', 'godkjent', 'fil'])
          && request.resource.data.dato == attFors(email).dato && request.resource.data.godkjent == true
          && request.resource.data.fil == (attFors(email).fil || resource.data.get('fil', false))
          && request.resource.data.by == request.auth.token.email && request.resource.data.updated == request.time)
        // Eldre datoer som ventet på godkjenning: gruppeleder eller administrator kan bekrefte dem direkte.
        || (attLed(email) && resource.data.get('godkjent', true) == false
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['godkjent', 'by', 'updated'])
          && request.resource.data.godkjent == true && request.resource.data.by == request.auth.token.email
          && request.resource.data.updated == request.time);
      allow delete: if (attParter(email) && attFerdig(email, 'slett')) || attRydd(email);
    }
    match /attestforslag/{email} {
      allow get: if attParter(email);
      allow list: if isAdmin();
      allow create: if attParter(email)
        && request.resource.data.keys().hasOnly(['k', 'dato', 'by', 'okM', 'okL', 'okLby', 'fil', 'ms'])
        && request.resource.data.k in ['sett', 'slett']
        && (request.resource.data.k == 'slett' ? !('dato' in request.resource.data)
            : (request.resource.data.dato is string && request.resource.data.dato.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')))
        && request.resource.data.by == request.auth.token.email
        && request.resource.data.fil is bool && request.resource.data.ms is number
        && request.resource.data.okM is bool && request.resource.data.okL is bool && request.resource.data.okLby is string
        && ((attSelf(email) && attLed(email))
            ? (request.resource.data.okM && request.resource.data.okL && request.resource.data.okLby == request.auth.token.email)
            : attSelf(email)
              ? (request.resource.data.okM && !request.resource.data.okL && request.resource.data.okLby == '')
              : (!request.resource.data.okM && request.resource.data.okL && request.resource.data.okLby == request.auth.token.email));
      allow update: if attParter(email)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['okM', 'okL', 'okLby'])
        && ((attSelf(email) && !attLed(email))
            ? (request.resource.data.okM == true && request.resource.data.okL == resource.data.okL && request.resource.data.okLby == resource.data.okLby)
            : (attLed(email) && !attSelf(email))
              ? (request.resource.data.okL == true && request.resource.data.okLby == request.auth.token.email && request.resource.data.okM == resource.data.okM)
              : false);
      allow delete: if attParter(email) || attRydd(email);
    }
    match /attestfil/{email} {
      allow get: if attParter(email);
      allow create, update: if attParter(email) && attFerdig(email, 'sett') && attFors(email).fil == true
        && request.resource.data.keys().hasOnly(['data', 'ftype', 'fnavn', 'ms'])
        && request.resource.data.data is string && request.resource.data.data.size() <= 950000;
      allow delete: if (attParter(email) && attFerdig(email, 'slett')) || attRydd(email);
    }
    match /attestfilny/{email} {
      allow get: if attParter(email);
      allow create, update: if attParter(email)
        && existsAfter(/databases/$(database)/documents/attestforslag/$(email))
        && getAfter(/databases/$(database)/documents/attestforslag/$(email)).data.by == request.auth.token.email
        && getAfter(/databases/$(database)/documents/attestforslag/$(email)).data.fil == true
        && request.resource.data.keys().hasOnly(['data', 'ftype', 'fnavn', 'ms'])
        && request.resource.data.data is string && request.resource.data.data.size() <= 950000;
      allow delete: if attParter(email) || attRydd(email);
    }
    // Utleie av bygget: administratorer og medlemmer i gruppen utleie leser og endrer bookingene (de inneholder navn og kontaktinfo til leietakere).
    function utleieTilgang() {
      return isAdmin() || (signedIn() && exists(/databases/$(database)/documents/members/$(request.auth.token.email))
        && 'utleie' in get(/databases/$(database)/documents/members/$(request.auth.token.email)).data.get('groups', []));
    }
    match /bookinger/{id}/team/{epost} {
      allow read: if utleieTilgang() || (signedIn() && exists(/databases/$(database)/documents/members/$(request.auth.token.email))
        && 'vertskap' in get(/databases/$(database)/documents/members/$(request.auth.token.email)).data.get('groups', []));
      // Hver kan svare for seg selv; gruppeledere, gruppen utleie og administratorer kan legge inn svar og invitasjoner (k = ingen) for andre.
      allow create, update: if signedIn() && isMember()
        && (epost == request.auth.token.email || utleieTilgang() || isLeader())
        && request.resource.data.keys().hasOnly(['n', 'k', 'ms', 'oppg'])
        && (!('oppg' in request.resource.data) || (request.resource.data.oppg is string && request.resource.data.oppg.size() <= 30))
        && request.resource.data.n is string && request.resource.data.n.size() <= 60
        && request.resource.data.k in ['ja', 'nei', 'vet', 'ingen']
        && request.resource.data.ms is number;
      allow delete: if utleieTilgang();
    }
    match /bookinger/{id} {
      allow read: if utleieTilgang() || (signedIn() && exists(/databases/$(database)/documents/members/$(request.auth.token.email))
        && 'vertskap' in get(/databases/$(database)/documents/members/$(request.auth.token.email)).data.get('groups', []));
      allow delete: if utleieTilgang();
      allow create, update: if utleieTilgang()
        && request.resource.data.keys().hasOnly(['tittel', 'rom', 'dato', 'dato2', 'tider', 'gjester', 'servering', 'maaltider', 'teamMaal', 'allergener', 'allergenNotat', 'fakturert', 'fakturertMs', 'fakturaVentH', 'fakturaUtsattTil', 'remindH', 'fra', 'til', 'leier', 'kontakt', 'epost', 'pris', 'status', 'notat', 'by', 'ms'])
        && request.resource.data.tittel is string && request.resource.data.tittel.size() <= 100
        && request.resource.data.rom is list && request.resource.data.rom.size() >= 1 && request.resource.data.rom.size() <= 10
        && request.resource.data.dato is string && request.resource.data.dato.size() == 10
        && (!('dato2' in request.resource.data) || (request.resource.data.dato2 is string && request.resource.data.dato2.size() <= 10))
        && (!('tider' in request.resource.data) || (request.resource.data.tider is list && request.resource.data.tider.size() <= 62))
        && (!('gjester' in request.resource.data) || (request.resource.data.gjester is number && request.resource.data.gjester >= 0 && request.resource.data.gjester <= 2000))
        && (!('servering' in request.resource.data) || (request.resource.data.servering is string && request.resource.data.servering.size() <= 200))
        && (!('teamMaal' in request.resource.data) || (request.resource.data.teamMaal is number && request.resource.data.teamMaal >= 0 && request.resource.data.teamMaal <= 50))
        && (!('maaltider' in request.resource.data) || (request.resource.data.maaltider is list && request.resource.data.maaltider.size() <= 8))
        && (!('allergener' in request.resource.data) || (request.resource.data.allergener is list && request.resource.data.allergener.size() <= 20))
        && (!('allergenNotat' in request.resource.data) || (request.resource.data.allergenNotat is string && request.resource.data.allergenNotat.size() <= 200))
        && (!('fakturert' in request.resource.data) || request.resource.data.fakturert is bool)
        && (!('fakturertMs' in request.resource.data) || request.resource.data.fakturertMs is number)
        && (!('fakturaVentH' in request.resource.data) || (request.resource.data.fakturaVentH is number && request.resource.data.fakturaVentH >= 1 && request.resource.data.fakturaVentH <= 720))
        && (!('fakturaUtsattTil' in request.resource.data) || request.resource.data.fakturaUtsattTil is number)
        && (!('remindH' in request.resource.data) || (request.resource.data.remindH is number && request.resource.data.remindH >= 0 && request.resource.data.remindH <= 720))
        && request.resource.data.fra is string && request.resource.data.fra.size() == 5
        && request.resource.data.til is string && request.resource.data.til.size() == 5
        && request.resource.data.leier is string && request.resource.data.leier.size() <= 100
        && request.resource.data.kontakt is string && request.resource.data.kontakt.size() <= 100
        && (!('epost' in request.resource.data) || (request.resource.data.epost is string && request.resource.data.epost.size() <= 100))
        && request.resource.data.pris is string && request.resource.data.pris.size() <= 30
        && request.resource.data.status in ['foresporsel', 'bekreftet']
        && request.resource.data.notat is string && request.resource.data.notat.size() <= 500
        && request.resource.data.by is string && request.resource.data.by.size() <= 80
        && request.resource.data.ms is number;
    }
    // Kontaktinfo som vises på Hjem og personvernteksten under Meg: alle kan lese, bare administrator endrer.
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin() && (
        (id == 'contact' && request.resource.data.keys().hasOnly(['address', 'hours', 'phone', 'email']))
        || (id == 'giving' && request.resource.data.keys().hasOnly(['konto', 'bank', 'vipps', 'giro', 'annet', 'testament'])
            && request.resource.data.konto is string && request.resource.data.konto.size() <= 40
            && request.resource.data.annet is string && request.resource.data.annet.size() <= 800
            && request.resource.data.giro is string && request.resource.data.giro.size() <= 400
            && (!('testament' in request.resource.data) || (request.resource.data.testament is string && request.resource.data.testament.size() <= 600)))
        || (id == 'julemesse' && request.resource.data.keys().hasOnly(['on', 'tittel', 'tid', 'sted', 'tekst', 'loddOn', 'loddFra', 'loddTil', 'loddInfo', 'premier', 'trukket', 'trukketMs'])
            && request.resource.data.on is bool && request.resource.data.loddOn is bool
            && request.resource.data.tittel is string && request.resource.data.tittel.size() <= 80
            && request.resource.data.tid is string && request.resource.data.tid.size() <= 80
            && request.resource.data.sted is string && request.resource.data.sted.size() <= 80
            && request.resource.data.tekst is string && request.resource.data.tekst.size() <= 1500
            && request.resource.data.loddInfo is string && request.resource.data.loddInfo.size() <= 600
            && request.resource.data.premier is string && request.resource.data.premier.size() <= 1500
            && request.resource.data.loddFra is number && request.resource.data.loddTil is number
            && request.resource.data.trukket is list && request.resource.data.trukket.size() <= 50
            && request.resource.data.trukketMs is number)
        || (id == 'utleie' && request.resource.data.keys().hasOnly(['rom', 'fakturaEpost', 'vertskapLedere'])
            && (!('vertskapLedere' in request.resource.data) || (request.resource.data.vertskapLedere is list && request.resource.data.vertskapLedere.size() <= 6))
            && (!('rom' in request.resource.data) || (request.resource.data.rom is list && request.resource.data.rom.size() <= 20))
            && (!('fakturaEpost' in request.resource.data) || (request.resource.data.fakturaEpost is string && request.resource.data.fakturaEpost.size() <= 100)))
        || (id == 'personvern' && request.resource.data.keys().hasOnly(['text', 'updated'])
            && request.resource.data.text is string && request.resource.data.text.size() <= 20000
            && request.resource.data.updated is string && request.resource.data.updated.size() <= 10));
    }
    // Sikkerhetspunkter for tilbakerulling (bare administratorer): oversikt i snapshots, innholdet som tekst i snapshotData.
    match /snapshots/{id} { allow read, write: if isAdmin(); }
    match /snapshotData/{id} { allow read, write: if isAdmin(); }
    // «Jeg kommer»-teller per arrangement. Alle kan lese og endre tallet med ett om gangen, bare administratorer kan slette.
    match /rsvpCounts/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == 1;
      allow update: if request.resource.data.keys().hasOnly(['n']) && request.resource.data.n is int && request.resource.data.n >= 0
        && (request.resource.data.n - resource.data.n == 1 || resource.data.n - request.resource.data.n == 1);
      allow delete: if isAdmin();
    }
    // Påmeldinger med navn («Jeg kommer»): alle kan melde seg på (og trekke seg), bare administratorer og gruppeledere leser listen.
    match /rsvps/{id} {
      allow create, update: if request.resource.data.keys().hasOnly(['eventId', 'title', 'start', 'name', 'contact', 'groups', 'created'])
        && request.resource.data.eventId is string && request.resource.data.eventId.size() <= 80
        && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 80
        && request.resource.data.contact is string && request.resource.data.contact.size() <= 120
        && request.resource.data.title is string && request.resource.data.title.size() <= 200
        && request.resource.data.start is string && request.resource.data.start.size() <= 20
        && request.resource.data.groups is list && request.resource.data.groups.size() <= 20
        && request.resource.data.created == request.time;
      allow delete: if true;
      allow read: if isAdmin() || isLeader();
    }

    // Antall som har sett en nyhet: alle kan telle opp med ett, bare administratorer og gruppeledere leser.
    match /postViews/{id} {
      allow read: if isAdmin() || isLeader();
      allow create: if request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == 1;
      allow update: if request.resource.data.keys().hasOnly(['n']) && request.resource.data.n is int && request.resource.data.n - resource.data.n == 1;
    }

    // Planlagte varsler: administratorer kan planlegge til alle, gruppeledere bare til egne grupper. Bare administratorer/scriptet leser og sletter.
    match /scheduled/{id} {
      allow create: if request.resource.data.keys().hasOnly(['title', 'body', 'tab', 'malType', 'groups', 'ltypes', 'kopi', 'fireAt', 'by', 'created'])
        && request.resource.data.title is string && request.resource.data.title.size() <= 100
        && request.resource.data.fireAt is int
        && (isAdmin() || (isLeader() && request.resource.data.malType == 'grupper'
             && request.resource.data.groups is list && request.resource.data.groups.size() > 0 && request.resource.data.groups.hasOnly(myLeads())));
      allow read, update, delete: if isAdmin();
    }

    // Lederkategorier (Hovedledere, Ungdomsledere, Forkynnere ...): bare administratorer.
    match /leaderTypes/{id} {
      allow read, write: if isAdmin();
    }

    // Kategorier for arrangementer og faste samlinger: alle kan lese, bare administratorer endrer.
    match /categories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Grupper (navn og beskrivelse): alle kan lese, bare administratorer endrer.
    match /groups/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Påminnelser før samlinger. Alle kan opprette og slette (id-en inneholder en del av varselkoden); bare administratorer/scriptet leser.
    match /reminders/{id} {
      allow create: if request.resource.data.keys().hasOnly(['token', 'title', 'fireAt', 'created'])
        && request.resource.data.token is string && request.resource.data.token.size() >= 100 && request.resource.data.token.size() <= 500
        && request.resource.data.title is string && request.resource.data.title.size() <= 200
        && request.resource.data.fireAt is int
        && request.resource.data.created == request.time;
      allow delete: if true;
      allow read, update: if isAdmin();
    }

    // Varselkoder for push. Besøkende kan registrere en enhet, men aldri tildele seg grupper (groups må være tom). En innlogget bruker
    // kan koble koden til sin egen e-post (email), og bare sin egen. Gruppene hentes fra brukerens oppføring i members/admins, aldri herfra. Koden er
    // dokument-ID og må ha lengde som en ekte FCM-kode. Å slette krever at man kjenner koden (den er hemmelig for enheten).
    // Bare administratorer kan lese listen eller sette grupper. Dette hindrer ikke at fremmede legger inn søppelkoder.
    match /pushTokens/{token} {
      allow create, update: if request.resource.data.keys().hasOnly(['token', 'groups', 'created', 'email'])
        && request.resource.data.token == token
        && token.size() >= 100 && token.size() <= 500
        && request.resource.data.groups is list && request.resource.data.groups.size() == 0
        && request.resource.data.created == request.time
        && (!('email' in request.resource.data) || (signedIn() && request.resource.data.email == request.auth.token.email));
      allow delete: if true;
      allow read, write: if isAdmin();
    }
    // Online-merke i Sionchat: hvert medlem skriver bare sitt eget tidspunkt (sist = servertid) og kan slette det. Medlemmer leser.
    match /tilstede/{email} {
      allow read: if isMember();
      allow create, update: if isMember() && request.auth.token.email == email
        && request.resource.data.keys().hasOnly(['sist']) && request.resource.data.sist == request.time;
      allow delete: if signedIn() && request.auth.token.email == email;
    }
    // Medlemslisten: e-postadressen er dokument-ID. Brukeren kan sjekke sin egen adresse, administratorer styrer listen.
    // Gruppeledere kan se medlemslisten (for å styre sine grupper), legge nye medlemmer inn i egne grupper, og bare endre feltet groups
    // på eksisterende medlemmer: de kan bare legge til eller fjerne grupper de selv leder.
    // Hva som er lagt til eller tatt bort i en liste (feltet f) må bare gjelde grupper en gruppeleder selv leder.
    function ledChg(f) {
      return request.resource.data.get(f, []).toSet().difference(resource.data.get(f, []).toSet()).hasOnly(myLeads())
        && resource.data.get(f, []).toSet().difference(request.resource.data.get(f, []).toSet()).hasOnly(myLeads());
    }
    match /members/{email} {
      allow get: if signedIn() && request.auth.token.email == email || isAdmin() || isLeader();
      allow list: if isAdmin() || isLeader();
      allow write: if isAdmin();
      // Hver bruker kan endre eget navn og hvilke gruppevarsler vedkommende vil ha (name, muted), og slette seg selv (ikke administratorer).
      allow update: if signedIn() && request.auth.token.email == email
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'muted'])
        && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 60))
        && (!('muted' in request.resource.data) || (request.resource.data.muted is list && request.resource.data.muted.size() <= 30));
      allow delete: if signedIn() && request.auth.token.email == email && !isAdmin();
      allow create: if isLeader()
        && request.resource.data.keys().hasOnly(['email', 'rolle', 'created', 'by', 'groups'])
        && request.resource.data.email == email
        && request.resource.data.groups is list && request.resource.data.groups.size() > 0
        && request.resource.data.groups.hasOnly(myLeads());
      // Gruppeleder: groups (med i gruppen), extra (varsel uten å være med) og muted (varsel av), men bare for egne grupper.
      allow update: if isLeader()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['groups', 'extra', 'muted'])
        && request.resource.data.get('groups', []) is list && request.resource.data.get('extra', []) is list && request.resource.data.get('muted', []) is list
        && ledChg('groups') && ledChg('extra') && ledChg('muted');
    }
    // Vakter per gruppe: bare gruppens medlemmer (og administratorer) leser. Leder av gruppen (eller administrator) endrer vaktene.
    // Medlemmer i gruppen kan sende en byttebeskjed (requests) som bare avsenderen, gruppens leder og administratorer ser.
    function inGroup(g) {
      return signedIn() && (isAdmin() || (exists(/databases/$(database)/documents/members/$(request.auth.token.email))
        && g in get(/databases/$(database)/documents/members/$(request.auth.token.email)).data.get('groups', [])));
    }
    function leadsGroup(g) {
      return isLeader() && g in myLeads();
    }
    match /shifts/{group}/items/{id} {
      allow read: if inGroup(group) || leadsGroup(group);
      allow write: if isAdmin() || leadsGroup(group);
    }
    match /shifts/{group}/requests/{id} {
      allow create: if (inGroup(group) || leadsGroup(group))
        && request.resource.data.keys().hasOnly(['shiftId', 'date', 'role', 'from', 'fromName', 'text', 'created'])
        && request.resource.data.from == request.auth.token.email
        && request.resource.data.text is string && request.resource.data.text.size() <= 300
        && request.resource.data.created == request.time;
      allow read, delete: if isAdmin() || leadsGroup(group) || (signedIn() && resource.data.from == request.auth.token.email);
    }

    // Private møtenotater: bare eieren (ikke engang administratorer). Maks 100 notater (plassene n1 til n100), hvert opptil 20 000 tegn.
    match /members/{email}/notes/{noteId} {
      allow read, delete: if signedIn() && request.auth.token.email == email && isMember();
      allow create, update: if signedIn() && request.auth.token.email == email && isMember()
        && noteId.matches('n([1-9]|[1-9][0-9]|100)')
        && request.resource.data.keys().hasOnly(['title', 'date', 'speaker', 'html', 'img', 'updated'])
        && request.resource.data.title is string && request.resource.data.title.size() <= 120
        && request.resource.data.speaker is string && request.resource.data.speaker.size() <= 80
        && request.resource.data.date is string && request.resource.data.date.size() <= 10
        && request.resource.data.html is string && request.resource.data.html.size() <= 20000
        && (!('img' in request.resource.data) || (request.resource.data.img is string && request.resource.data.img.size() <= 60000))
        && request.resource.data.updated == request.time;
    }
    // Administratorer er dokumenter i admins, med e-postadressen som dokument-ID. Bare administratorer kan endre listen.
    match /admins/{email} {
      allow get: if signedIn() && request.auth.token.email == email || isAdmin();
      allow list, write: if isAdmin();
    }
  }
}
